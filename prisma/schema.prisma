generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPERADMIN
  ADMIN
  SUPPORT
  TV
}

enum FranchiseMoment {
  IMPLANTACAO
  INAUGURADA
}

enum ContactType {
  WHATSAPP
  TELEFONE
  VIDEO_CHAMADA
  PRESENCIAL
  LIVE
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(SUPPORT)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  contacts     Contact[]
  sessions     Session[]
  hostedLives  Live[]    @relation("LiveHost")
  createdLives Live[]    @relation("LiveCreator")
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Franchisee {
  id        String          @id @default(cuid())
  name      String
  unitName  String
  photoUrl  String?         @map("photo_url")
  moment    FranchiseMoment @default(IMPLANTACAO)
  active    Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  contacts           Contact[]
  liveParticipations LiveParticipant[]

  @@map("franchisees")
}

model Live {
  id              String            @id @default(cuid())
  title           String
  scheduledAt     DateTime
  notes           String?
  hostUser        User              @relation("LiveHost", fields: [hostUserId], references: [id])
  hostUserId      String
  createdByUser   User              @relation("LiveCreator", fields: [createdByUserId], references: [id])
  createdByUserId String
  participants    LiveParticipant[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([scheduledAt])
  @@index([hostUserId])
}

model LiveParticipant {
  id           String     @id @default(cuid())
  live         Live       @relation(fields: [liveId], references: [id], onDelete: Cascade)
  liveId       String
  franchisee   Franchisee @relation(fields: [franchiseeId], references: [id])
  franchiseeId String
  contact      Contact    @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId    String     @unique
  createdAt    DateTime   @default(now())

  @@unique([liveId, franchiseeId])
  @@index([franchiseeId])
}

model Contact {
  id           String      @id @default(cuid())
  franchisee   Franchisee  @relation(fields: [franchiseeId], references: [id], onDelete: Cascade)
  franchiseeId String
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId       String?
  type         ContactType
  contactedAt  DateTime
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  liveParticipant LiveParticipant?

  @@index([franchiseeId, contactedAt])
  @@index([contactedAt, type])
}
