generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPERADMIN
  ADMIN
  SUPPORT
  TV
}

enum FranchiseMoment {
  IMPLANTACAO
  INAUGURADA
}

enum ContactType {
  WHATSAPP
  TELEFONE
  VIDEO_CHAMADA
  PRESENCIAL
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(SUPPORT)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  contacts Contact[]
  sessions Session[]
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Franchisee {
  id        String          @id @default(cuid())
  name      String
  unitName  String
  photoUrl  String?         @map("photo_url")
  moment    FranchiseMoment @default(IMPLANTACAO)
  active    Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  contacts Contact[]

  @@map("franchisees")
}

model Contact {
  id          String      @id @default(cuid())
  franchisee  Franchisee  @relation(fields: [franchiseeId], references: [id], onDelete: Cascade)
  franchiseeId String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  type        ContactType
  contactedAt DateTime
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([franchiseeId, contactedAt])
  @@index([contactedAt, type])
}
