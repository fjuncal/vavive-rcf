generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPERADMIN
  ADMIN
  SUPPORT
  TV
}

enum FranchiseMoment {
  IMPLANTACAO
  INAUGURADA
}

enum ContactType {
  WHATSAPP
  TELEFONE
  VIDEO_CHAMADA
  PRESENCIAL
  LIVE
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(SUPPORT)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  contacts     Contact[]
  sessions     Session[]
  hostedLives  Live[]    @relation("LiveHost")
  createdLives Live[]    @relation("LiveCreator")
  createdAdjustments InteractionAdjustment[] @relation("AdjustmentCreator")
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Franchisee {
  id        String          @id @default(cuid())
  name      String
  unitName  String
  photoUrl  String?         @map("photo_url")
  moment    FranchiseMoment @default(IMPLANTACAO)
  active    Boolean         @default(true)
  // Datas civis da UNIDADE (não da pessoa): @db.Date evita deslocamento
  // de timezone — 10/06/2024 permanece 10/06/2024. Opcionais: unidades
  // existentes ficam NULL até o SUPERADMIN preencher.
  joinedNetworkAt DateTime? @db.Date @map("joined_network_at")
  inauguratedAt   DateTime? @db.Date @map("inaugurated_at")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  contacts           Contact[]
  liveParticipations LiveParticipant[]
  interactionAdjustments InteractionAdjustment[]
  members            FranchiseeMember[]
  monthlyServiceCounts FranchiseeMonthlyServiceCount[]

  @@map("franchisees")
}

// ATENDIMENTOS MENSAIS DA UNIDADE: quantidade MANUAL por franquia/mês.
// 1 linha = 1 competência (franchiseeId + year + month únicos). year/month
// são INTEGER (sem timezone). Linha ausente = mês sem dado; 0 é válido.
// NÃO deriva de Contact/ajustes/Lives e nunca altera essas métricas.
// Exclusão da unidade remove o histórico (Cascade, como Contact e membros).
// Faixas (month 1–12, year 2000–2100, count >= 0) validadas no backend e
// reforçadas por CHECK constraints na migration.
model FranchiseeMonthlyServiceCount {
  id           String     @id @default(cuid())
  franchiseeId String
  franchisee   Franchisee @relation(fields: [franchiseeId], references: [id], onDelete: Cascade)
  year         Int
  month        Int
  count        Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([franchiseeId, year, month])
  @@index([year, month])
  @@map("franchisee_monthly_service_counts")
}

// PESSOA / FRANQUEADO: uma unidade (Franchisee) pode ter várias pessoas.
// Franchisee continua representando a UNIDADE (1 linha = 1 unidade);
// name/photoUrl antigos foram preservados para transição compatível.
model FranchiseeMember {
  id           String      @id @default(cuid())
  franchiseeId String
  franchisee   Franchisee  @relation(fields: [franchiseeId], references: [id], onDelete: Cascade)
  name         String
  photoUrl     String?
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  contacts       Contact[]
  participations LiveParticipant[]

  @@index([franchiseeId])
  @@map("franchisee_members")
}

model InteractionAdjustment {
  id              String     @id @default(cuid())
  franchiseeId    String
  franchisee      Franchisee @relation(fields: [franchiseeId], references: [id], onDelete: Cascade)
  amount          Int
  // Canal do ajuste (enum ContactType reutilizado, sem enum novo).
  // Nullable por compatibilidade histórica: ajustes legados têm NULL e
  // contam apenas no total geral, nunca em um canal específico.
  type            ContactType?
  notes           String?
  createdByUserId String
  createdByUser   User       @relation("AdjustmentCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt       DateTime   @default(now())

  @@index([franchiseeId, createdAt])
  @@map("interaction_adjustments")
}

model Live {
  id              String            @id @default(cuid())
  title           String
  scheduledAt     DateTime
  notes           String?
  hostUser        User              @relation("LiveHost", fields: [hostUserId], references: [id])
  hostUserId      String
  createdByUser   User              @relation("LiveCreator", fields: [createdByUserId], references: [id])
  createdByUserId String
  participants    LiveParticipant[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([scheduledAt])
  @@index([hostUserId])
}

model LiveParticipant {
  id           String     @id @default(cuid())
  live         Live       @relation(fields: [liveId], references: [id], onDelete: Cascade)
  liveId       String
  franchisee   Franchisee @relation(fields: [franchiseeId], references: [id])
  franchiseeId String
  attended     Boolean    @default(true)
  contact      Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contactId    String?    @unique
  // Pessoa participante (opcional): permite 2+ participações por unidade
  // numa mesma Live sem duplicar unidades. NULL = participação da unidade.
  member       FranchiseeMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  memberId     String?
  createdAt    DateTime   @default(now())

  @@unique([liveId, franchiseeId, memberId])
  @@index([franchiseeId])
  @@index([memberId])
}

model Contact {
  id           String      @id @default(cuid())
  franchisee   Franchisee  @relation(fields: [franchiseeId], references: [id], onDelete: Cascade)
  franchiseeId String
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId       String?
  // Pessoa com quem ocorreu o contato (opcional): NULL = contato da unidade,
  // fluxo rápido da TV continua sem escolher pessoa. Histórico antigo = NULL.
  member       FranchiseeMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  memberId     String?
  type         ContactType
  contactedAt  DateTime
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  liveParticipant LiveParticipant?

  @@index([franchiseeId, contactedAt])
  @@index([contactedAt, type])
  @@index([memberId])
}
